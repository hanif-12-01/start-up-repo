# ============================================================
# WattWise AI — Environment Variable Contract
# ============================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# ------------------------------------------------------------
# DATABASE (Production-required)
# ------------------------------------------------------------
# Neon PostgreSQL connection string.
# Must include ?sslmode=require for Neon.
# Required in production — server refuses to start if absent.
DATABASE_URL="postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/wattwise?sslmode=require"

# ------------------------------------------------------------
# AUTH (Production-required)
# ------------------------------------------------------------
# Secret key for Better Auth session signing.
# Must be at least 32 characters of random data.
# Required in production — server refuses to start if shorter.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-at-least-32-random-characters-before-production"

# Canonical public URL of the application (used for auth callbacks).
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# PUBLIC APPLICATION URL
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# FEATURE FLAGS (server-side enforced, default false)
# All flags are boolean strings: "true" | "false"
# ------------------------------------------------------------
DASHBOARD_ENABLED="false"
MONTHLY_REPORTS_ENABLED="false"
DIAGNOSTICS_ENABLED="false"
ACTION_PLANS_ENABLED="false"
OUTCOME_TRACKING_ENABLED="false"
SEGMENT_TEMPLATES_ENABLED="false"
BUSINESS_PORTFOLIO_ENABLED="false"
SENSOR_IMPORT_ENABLED="false"
ADVANCED_ML_ENABLED="false"
ENTITLEMENTS_ENABLED="false"

# ------------------------------------------------------------
# INTERNAL ANALYTICS (server-side enforced, default disabled)
# ------------------------------------------------------------
# Set to "true" to enable the /internal/analytics/funnel route.
FUNNEL_ANALYTICS_ENABLED="false"

# Comma-separated list of user IDs allowed to view funnel analytics.
# Empty string = no one has access even if flag is enabled.
# Example: "user-id-1,user-id-2"
FUNNEL_ANALYTICS_VIEWER_USER_IDS=""
