{
  "schema_version": "1.0",
  "allowed_provenance_values": ["UNCLASSIFIED", "REAL_WATTWISE", "SYNTHETIC_DEMO"],
  "promotion_provenance": "REAL_WATTWISE",
  "history_temporal_integrity_required": true,
  "application_timezone": "Asia/Jakarta",
  "completed_history_rule": "inclusive period_end must be before forecast_origin local calendar date",
  "promotion_grade_filter": {
    "data_provenance": "REAL_WATTWISE",
    "prospective_forecast": true,
    "actual_outcome_available": true,
    "valid_actual_sources": ["USER_ENTERED", "METER_DERIVED"],
    "ml_prediction_available": true,
    "application_deterministic_prediction_available": true
  },
  "excluded": ["SYNTHETIC_DEMO", "UNCLASSIFIED", "LEGACY_UNKNOWN", "BDG2", "LONDON_SMARTMETER", "NREL_COMSTOCK", "LOAD_TESTS"],
  "prospective_rule": "forecast_origin < start_of_target_month",
  "target_value_used_as_input": false,
  "python_receives_tenant_identifier": false
}
